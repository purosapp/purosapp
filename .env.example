# Optional when using the local tidalapi bridge:
# TIDAL_PYTHON_BIN=/absolute/path/to/python3
# TIDAL_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Only needed if you switch back to the official developer API flow:
TIDAL_CLIENT_ID=your_tidal_client_id
TIDAL_CLIENT_SECRET=your_tidal_client_secret
TIDAL_REDIRECT_URI=http://127.0.0.1:47892/tidal/callback
# Optional overrides:
# TIDAL_SCOPES=r_usr w_usr
# TIDAL_DEFAULT_COUNTRY_CODE=US
# TIDAL_AUDIO_QUALITY=MAX
# TIDAL_REQUEST_TIMEOUT_MS=15000
# TIDAL_MAX_RETRIES=2

# Built-in Last.fm scrobbling, including PUROS_PROVIDERS=none builds.
# Set these before building; Vite embeds them only in the Electron main process.
# LASTFM_API_KEY=your_lastfm_api_key
# LASTFM_API_SECRET=your_lastfm_shared_secret

# Discord Rich Presence (optional)
# DISCORD_RICH_PRESENCE_ENABLED=true
# Optional Discord Rich Presence artwork assets:
# DISCORD_SMALL_IMAGE_KEY=puros
# DISCORD_SMALL_IMAGE_URL=https://your-hosted-domain/puros-icon.png
# DISCORD_LARGE_IMAGE_KEY=puros
# DISCORD_LARGE_IMAGE_URL=https://your-hosted-domain/puros-cover-fallback.png
